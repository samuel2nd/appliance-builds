# Site-specific configuration for mv-host profile
# Copy to site.env and customize for your deployment
# site.env is gitignored and never committed

# Hostname for this appliance
HOSTNAME="mv-appliance"

# Network configuration (optional - only needed for dual-NIC setup)
# Leave commented to skip network configuration in bootstrap

# Management network (onboard NIC)
#MGMT_INTERFACE="enp1s0"
#MGMT_IP="192.168.1.100/24"
#MGMT_GATEWAY=""

# Camera network (USB NIC) - for isolated camera VLAN
#CAM_INTERFACE="enxXXXXXXXXXXXX"
#CAM_IP="192.168.2.100/24"
#CAM_GATEWAY=""
